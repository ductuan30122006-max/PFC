# Session cookie signing key (HMAC-SHA256). Required. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PFC_SESSION_SECRET=
# libSQL URL. Local file by default; Turso in production (libsql://...).
PFC_DB_URL=file:.data/pfc.sqlite
# Required only for Turso URLs.
PFC_DB_AUTH_TOKEN=
# Existing hub backends, reached through same-origin proxy rewrites (ADR-010).
CLUB_API_ORIGIN=http://127.0.0.1:3000
OPP_API_ORIGIN=http://127.0.0.1:3001
# Comma-separated emails that become Chủ nhiệm when they register (bootstrap a fresh install).
PFC_OWNER_EMAILS=
# Platform SSO shared secrets (ADR-011); must equal the hub-side values.
CLUB_SSO_SECRET=
OPP_SSO_SECRET=

# --- Đăng nhập (SYS-02…06) ---
# Public origin used in email links and OAuth redirect URIs (never taken from the request Host header).
PFC_PUBLIC_URL=http://localhost:3200
# Google: OAuth client (Web). Authorised redirect URI: <PFC_PUBLIC_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook Login. Valid OAuth redirect URI: <PFC_PUBLIC_URL>/api/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Email: "log" prints messages to the server log (dev only); "resend" sends via Resend.
PFC_MAIL_MODE=
RESEND_API_KEY=
PFC_MAIL_FROM=
# 1 = members must verify their email before password login.
PFC_REQUIRE_EMAIL_VERIFICATION=
